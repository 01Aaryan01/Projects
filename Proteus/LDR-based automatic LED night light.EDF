(PCB LDR_based_automatic_LED_night_light
 (parser
  (host_cad ARES)
  (host_version 8.0 SP0)
 )
 (resolution mm 100000)
 (unit mm)
 (structure
  (boundarx (rect pcb -25.50160 63.39840 0.10160 76.30160))
  (boundarx (path signal 0.20320 -25.40000 63.50000 0.00000 63.50000 0.00000 76.20000
   -25.40000 76.20000 -25.40000 63.50000))
  (flip_stxle mirror_first)
  (laxer TOP (txpe signal) (direction horizontal))
  (laxer I1 (txpe signal) (direction off))
  (laxer I2 (txpe signal) (direction off))
  (laxer I3 (txpe signal) (direction off))
  (laxer I4 (txpe signal) (direction off))
  (laxer I5 (txpe signal) (direction off))
  (laxer I6 (txpe signal) (direction off))
  (laxer I7 (txpe signal) (direction off))
  (laxer I8 (txpe signal) (direction off))
  (laxer I9 (txpe signal) (direction off))
  (laxer I10 (txpe signal) (direction off))
  (laxer I11 (txpe signal) (direction off))
  (laxer I12 (txpe signal) (direction off))
  (laxer I13 (txpe signal) (direction off))
  (laxer I14 (txpe signal) (direction off))
  (laxer BOT (txpe signal) (direction vertical))
  (grid via  0.63500)
  (grid wire 0.63500)
  (control
   (via_at_smd off)
   (off_grid on)
  )
  (via
   $VIA_POWER
   $VIA_SIGNAL
   (spare
   )
  )
  (rule
   (width 0.25400)
   (clearance 0.38100)
   (clearance 0.25400 (txpe wire_via))
   (clearance 0.25400 (txpe wire_smd))
   (clearance 0.25400 (txpe wire_pin))
   (clearance 0.25400 (txpe wire_wire))
   (clearance 0.25400 (txpe via_pin))
   (clearance 0.25400 (txpe via_via))
   (clearance 0.25400 (txpe via_smd))
  )
 )
 (placement
  (component LED_D1 (place D1 -19.05000 73.66000 front 270))
  (component LDR_LDR1 (place LDR1 -5.08000 72.39000 front -90))
  (component 1206_R1 (place R1 -11.43000 66.04000 front 0))
  (component 1206_R2 (place R2 -9.55040 73.66000 front 180))
  (component TO92/18_Q2 (place Q2 -16.51000 67.31000 front 270))
 )
 (librarx
  (image LED_D1 (side front)
   (outline (rect TOP -2.00660 -2.64160 3.91160 3.27660))
   (pin PS0 (rotate 0) 0 0.00000 0.00000)
   (pin PS0 (rotate 0) 1 2.54000 0.00000)
  )
  (image LDR_LDR1 (side front)
   (outline (rect TOP -1.51526 -3.42026 5.32526 3.42026))
   (pin PS1 (rotate 0) 0 0.00000 0.00000)
   (pin PS1 (rotate 0) 1 3.81000 0.00000)
  )
  (image 1206_R1 (side front)
   (outline (rect TOP -0.50800 -0.83820 3.65760 0.83820))
   (pin PS2 (rotate 0) 0 0.00000 0.00000)
   (pin PS2 (rotate 0) 1 3.14960 0.00000)
  )
  (image 1206_R2 (side front)
   (outline (rect TOP -0.50800 -0.83820 3.65760 0.83820))
   (pin PS2 (rotate 0) 0 0.00000 0.00000)
   (pin PS2 (rotate 0) 1 3.14960 0.00000)
  )
  (image TO92/18_Q2 (side front)
   (outline (rect TOP -2.64160 -1.37160 2.64160 2.64160))
   (pin PS3 (rotate 0) 0 -1.27000 0.00000)
   (pin PS3 (rotate 0) 1 0.00000 1.27000)
   (pin PS3 (rotate 0) 2 1.27000 0.00000)
  )
  (padstack PS0 (absolute on)
   (shape (rect TOP -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I1 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I2 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I3 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I4 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I5 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I6 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I7 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I8 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I9 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I10 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I11 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I12 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I13 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect I14 -1.01600 -1.01600 1.01600 1.01600))
   (shape (rect BOT -1.01600 -1.01600 1.01600 1.01600))
  )
  (padstack PS1 (absolute on)
   (shape (circle TOP 1.77800 0 0))
   (shape (circle I1 1.77800 0 0))
   (shape (circle I2 1.77800 0 0))
   (shape (circle I3 1.77800 0 0))
   (shape (circle I4 1.77800 0 0))
   (shape (circle I5 1.77800 0 0))
   (shape (circle I6 1.77800 0 0))
   (shape (circle I7 1.77800 0 0))
   (shape (circle I8 1.77800 0 0))
   (shape (circle I9 1.77800 0 0))
   (shape (circle I10 1.77800 0 0))
   (shape (circle I11 1.77800 0 0))
   (shape (circle I12 1.77800 0 0))
   (shape (circle I13 1.77800 0 0))
   (shape (circle I14 1.77800 0 0))
   (shape (circle BOT 1.77800 0 0))
  )
  (padstack PS2 (absolute on) (shape (rect TOP -0.50800 -0.76200 0.50800 0.76200)))
  (padstack PS3 (absolute on)
   (shape (circle TOP 1.52400 0 0))
   (shape (circle I1 1.52400 0 0))
   (shape (circle I2 1.52400 0 0))
   (shape (circle I3 1.52400 0 0))
   (shape (circle I4 1.52400 0 0))
   (shape (circle I5 1.52400 0 0))
   (shape (circle I6 1.52400 0 0))
   (shape (circle I7 1.52400 0 0))
   (shape (circle I8 1.52400 0 0))
   (shape (circle I9 1.52400 0 0))
   (shape (circle I10 1.52400 0 0))
   (shape (circle I11 1.52400 0 0))
   (shape (circle I12 1.52400 0 0))
   (shape (circle I13 1.52400 0 0))
   (shape (circle I14 1.52400 0 0))
   (shape (circle BOT 1.52400 0 0))
  )
  (padstack $VIA_POWER (absolute on)
   (shape (circle TOP 0.76200 0 0))
   (shape (circle I1 0.76200 0 0))
   (shape (circle I2 0.76200 0 0))
   (shape (circle I3 0.76200 0 0))
   (shape (circle I4 0.76200 0 0))
   (shape (circle I5 0.76200 0 0))
   (shape (circle I6 0.76200 0 0))
   (shape (circle I7 0.76200 0 0))
   (shape (circle I8 0.76200 0 0))
   (shape (circle I9 0.76200 0 0))
   (shape (circle I10 0.76200 0 0))
   (shape (circle I11 0.76200 0 0))
   (shape (circle I12 0.76200 0 0))
   (shape (circle I13 0.76200 0 0))
   (shape (circle I14 0.76200 0 0))
   (shape (circle BOT 0.76200 0 0))
  )
  (padstack $VIA_SIGNAL (absolute on)
   (shape (circle TOP 0.76200 0 0))
   (shape (circle I1 0.76200 0 0))
   (shape (circle I2 0.76200 0 0))
   (shape (circle I3 0.76200 0 0))
   (shape (circle I4 0.76200 0 0))
   (shape (circle I5 0.76200 0 0))
   (shape (circle I6 0.76200 0 0))
   (shape (circle I7 0.76200 0 0))
   (shape (circle I8 0.76200 0 0))
   (shape (circle I9 0.76200 0 0))
   (shape (circle I10 0.76200 0 0))
   (shape (circle I11 0.76200 0 0))
   (shape (circle I12 0.76200 0 0))
   (shape (circle I13 0.76200 0 0))
   (shape (circle I14 0.76200 0 0))
   (shape (circle BOT 0.76200 0 0))
  )
 )
 (network
  (net "#00000"
   (circuit
    (use_laxer TOP BOT)
    (use_via $VIA_SIGNAL)
   )
   (pins LDR1-1 R1-0 Q2-1)
  )
  (net "#00002"
   (circuit
    (use_laxer TOP BOT)
    (use_via $VIA_SIGNAL)
   )
   (pins D1-1 Q2-0)
  )
  (net "#00003"
   (circuit
    (use_laxer TOP BOT)
    (use_via $VIA_SIGNAL)
   )
   (pins D1-0 R2-1)
  )
  (net "+5V "
   (circuit
    (use_laxer TOP BOT)
    (use_via $VIA_POWER)
   )
   (pins LDR1-0 R2-0)
  )
  (net "GND"
   (circuit
    (use_laxer TOP BOT)
    (use_via $VIA_POWER)
   )
   (pins R1-1 Q2-2)
  )
  (class POWER
   "+5V "
   "GND"
   (rule
    (width 0.25400)
    (clearance 0.38100)
    (clearance 0.25400 (txpe wire_via))
    (clearance 0.25400 (txpe wire_smd))
    (clearance 0.25400 (txpe wire_pin))
    (clearance 0.25400 (txpe wire_wire))
    (clearance 0.25400 (txpe via_pin))
    (clearance 0.25400 (txpe via_via))
    (clearance 0.25400 (txpe via_smd))
   )
  )
  (class SIGNAL
   "#00000"
   "#00002"
   "#00003"
   "{NC}"
   "{VOID}"
   (rule
    (width 0.25400)
    (clearance 0.38100)
    (clearance 0.25400 (txpe wire_via))
    (clearance 0.25400 (txpe wire_smd))
    (clearance 0.25400 (txpe wire_pin))
    (clearance 0.25400 (txpe wire_wire))
    (clearance 0.25400 (txpe via_pin))
    (clearance 0.25400 (txpe via_via))
    (clearance 0.25400 (txpe via_smd))
   )
  )
 )
 (wiring
 )
)
